# Copy this file to `.env` and adjust the values for your machine.
# `.env` is gitignored — never commit real paths or secrets.

# Host path where your iPod is mounted (bind-mounted to /ipod in the container).
IPOD_MOUNTPOINT=/media

# Host path to your music library / deemix download target
# (bind-mounted to /music in the container).
MUSIC_DIR_HOST=/path/to/your/Music

# Directory on the host where app settings/state are persisted (defaults to ./data).
SETTINGS_DIR=./data

# Network binding for the published port.
HOST_IP=0.0.0.0
HOST_PORT=8080
APP_PORT=8080

# Subfolder inside /music that deemix downloads into (default: deemix).
DEEMIX_DOWNLOAD_SUBDIR=deemix

# Gunicorn concurrency. Keep a single worker (deemix job state is in-process);
# scale with threads instead.
GUNICORN_THREADS=8

# NOTE: The Deezer ARL token is NOT set here. Configure it in the Podify
# Settings panel; it is stored server-side in data/deemix_config.json.

# NOTE: Spotify API credentials are NOT set here either. Add the Client ID and
# Client Secret in the Podify Settings panel; they are stored server-side in
# data/spotify_config.json, and tracked playlists in data/spotify_playlists.json.
